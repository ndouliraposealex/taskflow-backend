# Serveur
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Base de données (SQLite par defaut - aucun serveur requis)
DB_PATH=taskflow.sqlite

# Redis (optionnel en local - cache en memoire utilise automatiquement si absent)
# En Docker Compose: redis://redis:6379
REDIS_URL=

# JWT
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=1d

# API externe - OpenWeather (cle gratuite sur https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweather_api_key_here